# 三竹簡訊憑證範本 — 複製成 .env（本機）或放 /etc/mitake-sms.env（VPS，權限 600）
# 絕不填入真實值後 commit：.env 已在 .gitignore

MITAKE_USERNAME=your_account_here
MITAKE_PASSWORD=your_password_here

# 餘額告警門檻（點）
MITAKE_ALERT_THRESHOLD=1000

# 告警通知管道（Telegram + Gmail 雙送）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GMAIL_USER=
GMAIL_APP_PASSWORD=
